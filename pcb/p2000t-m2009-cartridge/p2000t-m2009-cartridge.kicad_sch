	)
	(text "~{RD-INT} and ~{WR-INT} needs be handled via the coprocesser within 950 ns\n~{RD-INT} P2000T executes IN(x), ESP needs to set data on I/00-7\n~{WR-INT} P2000T executes OUT(x,b), ESP needs to read data from I/00-7\nPA0-2 provides the port number (0x40-047) for the IN() or OUT()\n~{P-RES} EPS follows with reset on reset of P2000T"
		(exclude_from_sim no)
		(at 160.02 144.526 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2a23664e-5a76-4c42-9b64-f3094834704c")
	)
